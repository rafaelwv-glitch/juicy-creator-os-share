# Copy to `.env.local` (gitignored) if you want to override defaults.

# App-level accounts are OFF in this shareable clone.
VITE_AUTH_ENABLED=false

# Optional: local Postgres (Docker). Leave unset to use file-backed PGLite.
# DATABASE_URL=postgres://juicy:juicy@localhost:5432/juicy

# Optional: override the local DB folder (JSON warehouse + PGLite).
# Default Linux:   ~/.local/share/juicy-creator-os/{lounge,pglite}
# Default Windows: %APPDATA%\Juicy Creator OS\{lounge,pglite}
# Default macOS:   ~/Library/Application Support/Juicy Creator OS/{lounge,pglite}
# Electron:        app userData (or next to a portable .exe)
# Existing ./data checkouts are still used if last-snapshot.json is already there.
# JUICY_DATA_DIR=
# PGLITE_DATA_DIR=

# Optional: bind the local cron helper to a running dev server
# LOCAL_APP_URL=http://127.0.0.1:8080

# Optional: lock cron HTTP. Empty = local dashboard only.
# CRON_SECRET=
