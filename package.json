{
  "name": "juicy-creator-os-share",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:vite": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && npm run db:migrate",
    "start": "node scripts/start-local.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import-warehouse": "node scripts/import-warehouse.mjs",
    "db:smoke": "node scripts/smoke-local-db.mjs",
    "cron:local": "node scripts/cron-local.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "node scripts/smoke-local-only.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:forensics": "node scripts/smoke-forensics-client.mjs",
    "smoke:client": "node scripts/smoke-client-qa.mjs",
    "smoke:qa": "node scripts/smoke-local-only.mjs && node scripts/smoke-forensics-client.mjs && node scripts/smoke-timing.mjs && node scripts/smoke-rivals-compare.mjs",
    "desktop": "electron desktop/main.mjs",
    "desktop:build": "npm run build && electron-builder --linux AppImage tar.gz dir --publish never",
    "desktop:build:win": "electron-builder --win zip nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@electric-sql/pglite": "^0.5.3",
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-start": "^1.160.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.160.0",
    "better-auth": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260603-beta",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.52.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "description": "Local JuicyChat creator dashboard — laptop + desktop, no Vercel, no keys",
  "license": "MIT",
  "author": "Juicy Creator OS contributors",
  "build": {
    "appId": "ai.juicylounge.creatoros.share",
    "productName": "Juicy Creator OS",
    "copyright": "MIT",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      {
        "from": "node_modules/nitro/dist/node_modules",
        "to": "node_modules/nitro/dist/node_modules"
      },
      "!release/**",
      "!data/**",
      "!.git/**",
      "!.vercel/**",
      "!.github/**",
      "!**/*.map"
    ],
    "extraResources": [
      "fixtures"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Juicy-Creator-OS-${version}-win-${arch}.${ext}",
      "executableName": "Juicy-Creator-OS",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Juicy Creator OS",
      "uninstallDisplayName": "Juicy Creator OS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Juicy-Creator-OS-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Juicy-Creator-OS-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "dir"
      ],
      "category": "Utility",
      "maintainer": "Juicy Creator OS contributors",
      "artifactName": "Juicy-Creator-OS-${version}-linux-${arch}.${ext}",
      "executableName": "juicy-creator-os"
    },
    "asar": false
  },
  "version": "1.2.0",
  "main": "desktop/main.mjs"
}
